# Copy to .env and fill in values. Never commit .env.
ANTHROPIC_API_KEY=your_key_here
DB_PASSWORD=your_db_password

# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_char_random_string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Leave empty to disable Swagger UI in production
DOCS_URL=

# SMTP — leave SMTP_HOST empty to skip sending (dev mode logs the URL).
# To test real emails locally use Mailpit (see docs/smtp-setup.md):
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
# then view captured mail at http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Discipliner <noreply@discipliner.app>
FRONTEND_URL=http://localhost:3000

# You can use this mailpit env to test
# SMTP — Mailpit (catcher local, UI em http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Discipliner <noreply@discipliner.app>
FRONTEND_URL=http://localhost:3000
